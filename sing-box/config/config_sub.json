{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {
        "tag": "Local",
        "type": "local",
        "prefer_go": true
      },
      {
        "tag": "Dnspod-DNS",
        "type": "https",
        "domain_resolver": "Hosts",
        "server": "doh.pub"
      },
      {
        "tag": "Google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "默认"
      },
      {
        "tag": "Fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "Hosts",
        "type": "hosts",
        "predefined": {
          "doh.pub": ["1.12.12.12", "120.53.53.53"]
        }
      }
    ],
    "rules": [
      {
        "query_type": ["HTTPS", "SVCB"],
        "action": "reject"
      },
      {
        "rule_set": [
          "fakeipfilter-cn",
          "geosite-cn",
          "geosite-microsoft@cn",
          "geosite-apple@cn",
          "geosite-private"
        ],
        "server": "Dnspod-DNS"
      },
      {
        "rule_set": "fakeipfilter-!cn",
        "server": "Google"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": ["A", "AAAA"]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "Google",
        "client_subnet": "223.5.5.0/24",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "server": "Dnspod-DNS"
      },
      {
        "query_type": ["A", "AAAA"],
        "server": "Fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "Google",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 20122
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "address": ["172.18.0.1/30"],
      "auto_route": true,
      "strict_route": true,
      "route_exclude_address": [
        "192.168.0.0/16",
        "10.0.0.0/8",
        "224.0.0.0/4",
        "169.254.0.0/16"
      ],
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 20122
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "默认",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "默认 2",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "✈️ Telegram",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "▶️ YouTube",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "📺 Netflix",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "🌐 Google",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认 2", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "🤖 AI",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认 2", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "💭 X",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认 2", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "♾️ Meta",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认 2", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "🎬 TikTok",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认 2", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本"]
    },
    {
      "tag": "💰 PayPal",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["默认 2", "🇺🇸 美国", "🇭🇰 香港", "🇹🇼 台湾", "🇸🇬 新加坡", "🇯🇵 日本", "直连"]
    },
    {
      "tag": "🇺🇸 美国",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["🇺🇸 美国自动♻️"]
    },
    {
      "tag": "🇭🇰 香港",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": ["🇭🇰 香港自动♻️"]
    },
    {
      "tag": "🇹🇼 台湾",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "tag": "🇸🇬 新加坡",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "tag": "🇯🇵 日本",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "tag": "🇺🇸 美国自动♻️",
      "type": "urltest",
      "outbounds": [],
      "url": "http://www.apple.com/library/test/success.html",
      "interval": "30m",
      "tolerance": 100,
      "interrupt_exist_connections": true
    },
    {
      "tag": "🇭🇰 香港自动♻️",
      "type": "urltest",
      "outbounds": [],
      "url": "http://www.apple.com/library/test/success.html",
      "interval": "30m",
      "tolerance": 100,
      "interrupt_exist_connections": true
    },
    {
      "tag": "直连",
      "type": "direct",
      "domain_resolver": "Dnspod-DNS"
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": "push.apple.com"
          },
          {
            "rule_set": "geoip-telegram"
          }
        ],
        "invert": true,
        "action": "sniff",
        "sniffer": ["http", "tls", "stun", "quic", "dns"],
        "timeout": "100ms"
      },
      {
        "ip_is_private": true,
        "outbound": "直连"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": ["stun", "quic"]
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "network": "icmp",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "直连"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": ["nuphyio.com", "aihot.virxact.com"]
          },
          {
            "ip_cidr": ["82.158.226.4"]
          }
        ],
        "outbound": "直连"
      },
      {
        "rule_set": [
          "geosite-category-ai-!cn",
          "geosite-openai",
          "geosite-anthropic",
          "geosite-google-gemini"
        ],
        "outbound": "🤖 AI"
      },
      {
        "rule_set": "geosite-youtube",
        "outbound": "▶️ YouTube"
      },
      {
        "rule_set": "geosite-google",
        "outbound": "🌐 Google"
      },
      {
        "rule_set": ["geosite-telegram", "geoip-telegram"],
        "outbound": "✈️ Telegram"
      },
      {
        "rule_set": "geosite-x",
        "outbound": "💭 X"
      },
      {
        "rule_set": "geosite-facebook",
        "outbound": "♾️ Meta"
      },
      {
        "rule_set": "geosite-tiktok",
        "outbound": "🎬 TikTok"
      },
      {
        "rule_set": "geosite-netflix",
        "outbound": "📺 Netflix"
      },
      {
        "rule_set": "geosite-paypal",
        "outbound": "💰 PayPal"
      },
      {
        "rule_set": ["geosite-microsoft@cn", "geosite-apple@cn", "geosite-steam@cn"],
        "outbound": "直连"
      },
      {
        "rule_set": [
          "geosite-github",
          "geosite-onedrive",
          "geosite-microsoft",
          "geosite-apple",
          "geosite-steam",
          "geosite-geolocation-!cn"
        ],
        "outbound": "默认"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve"
      },
      {
        "rule_set": ["geoip-cn", "geosite-cn"],
        "outbound": "直连"
      }
    ],
    "rule_set": [
      {
        "tag": ["fakeipfilter-cn", "fakeipfilter-!cn"],
        "type": "remote",
        "format": "source",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json"
      },
      {
        "tag": [
          "geosite-category-ai-!cn",
          "geosite-openai",
          "geosite-anthropic",
          "geosite-google-gemini",
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-onedrive",
          "geosite-microsoft",
          "geosite-microsoft@cn",
          "geosite-apple",
          "geosite-apple@cn",
          "geosite-telegram",
          "geosite-tiktok",
          "geosite-netflix",
          "geosite-x",
          "geosite-facebook",
          "geosite-paypal",
          "geosite-steam@cn",
          "geosite-steam",
          "geosite-geolocation-!cn",
          "geosite-cn",
          "geosite-private"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"
      },
      {
        "tag": "geoip-telegram",
        "type": "remote",
